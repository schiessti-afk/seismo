APP_NAME=Seismo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=seismo
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sail
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6380
WWWGROUP=1000
WWWUSER=1000

# Reverb (WebSockets)
REVERB_APP_ID=seismo
REVERB_APP_KEY=seismo-reverb-key
REVERB_APP_SECRET=seismo-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# USGS feeds (no API key)
USGS_BACKFILL_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_month.geojson
USGS_LIVE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson

# Seismo
SEISMO_INGEST_SECONDS=60
SEISMO_BACKFILL_ON_BOOT=true
SEISMO_LIVE_WINDOW_HOURS=24
SEISMO_LIVE_WINDOW_PRESETS=1,3,6,12,24,48,168
SEISMO_HISTORY_SLICE_HOURS=6
SEISMO_LIST_PAGE_SIZE=15
SEISMO_BROADCAST_MIN_MAGNITUDE=2.5
SEISMO_DEFAULT_FILTER_MIN_MAGNITUDE=2.5
SEISMO_ALERT_MIN_MAGNITUDE=5.0
